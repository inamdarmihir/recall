# Required only for the live Deep Agents demo (examples/map_reduce_docs.py).
# Unit tests use in-memory Qdrant and do not call LLM providers.
ANTHROPIC_API_KEY=

# Qdrant HTTP endpoint used by SubagentResultCacheMiddleware / the demo.
QDRANT_URL=http://localhost:6333

# Models aligned with Deep Agents harness profiles (deepagents>=0.7).
# Override if your provider catalog differs.
RECALL_ORCHESTRATOR_MODEL=anthropic:claude-sonnet-4-6
RECALL_WORKER_MODEL=anthropic:claude-haiku-4-5
